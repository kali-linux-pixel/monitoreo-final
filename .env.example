# Configuración del Servidor

# Puerto del servidor
PORT=3000

# Entorno (development, production)
NODE_ENV=development

# Base de Datos MongoDB
# Local: mongodb://localhost/monitoring
# Atlas: mongodb+srv://usuario:contraseña@cluster.mongodb.net/monitoring
MONGODB_URI=mongodb://localhost/monitoring

# CORS - Origen permitido
CORS_ORIGIN=*

# Google Maps API Key
# Obtén tu clave en: https://developers.google.com/maps
GOOGLE_MAPS_API_KEY=YOUR_API_KEY

# JWT - Secreto para autenticación (cambia esto en producción)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info
