{
  "name": "monitoreo",
  "version": "1.0.0",
  "description": "Sistema de Monitoreo en Vivo con Geolocalización y Transmisión de Video WebRTC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\" --names \"BACK,FRONT\" -c \"blue,magenta\""
  },
  "keywords": [
    "monitoreo",
    "geolocalización",
    "webrtc",
    "socket.io",
    "tiempo-real",
    "video"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
